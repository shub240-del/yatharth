  "components": {
    "schemas": {
      "ConsentCreate": {
        "properties": {
          "family_id": {
            "type": "string",
            "title": "Family Id"
          },
          "protected_person_id": {
            "type": "string",
            "title": "Protected Person Id"
          },
          "scope": {
            "type": "string",
            "const": "DIGITAL_SAFETY",
            "title": "Scope",
            "default": "DIGITAL_SAFETY"
          },
          "external_ai_allowed": {
            "type": "boolean",
            "title": "External Ai Allowed",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "family_id",
          "protected_person_id"
        ],
        "title": "ConsentCreate"
      },
      "FamilyCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "FamilyCreate"
      },
      "Feedback": {
        "properties": {
          "label": {
            "type": "string",
            "enum": [
              "TRUE_RISK",
              "FALSE_POSITIVE",
              "MISSED_RISK"
            ],
            "title": "Label"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "label"
        ],
        "title": "Feedback"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Login": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Login"
      },
      "MemberCreate": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "relationship": {
            "type": "string",
            "maxLength": 60,
            "minLength": 1,
            "title": "Relationship"
          },
          "join_code": {
            "type": "string",
            "maxLength": 100,
            "title": "Join Code",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "user_id",
          "relationship"
        ],
        "title": "MemberCreate"
      },
      "MessageInput": {
        "properties": {
          "family_id": {
            "type": "string",
            "title": "Family Id"
          },
          "sender_id": {
            "type": "string",
            "title": "Sender Id"
          },
          "content": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Content"
          },
          "source": {
            "type": "string",
            "enum": [
              "SIMULATOR",
              "MANUAL",
              "API"
            ],
            "title": "Source",
            "default": "MANUAL"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "family_id",
          "sender_id",
          "content"
        ],
        "title": "MessageInput"
      },
      "UserCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "minLength": 3,
            "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
            "title": "Email"
          },
          "phone": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 30
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone"
          },
          "role": {
            "type": "string",
            "enum": [
              "PROTECTED_PERSON",
              "CAREGIVER"
            ],
            "title": "Role"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 12,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "email",
          "role",
          "password"
        ],
        "title": "UserCreate"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}