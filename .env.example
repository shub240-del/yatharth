# Local SQLite default; Docker overrides to PostgreSQL.
DATABASE_URL=sqlite:///./yatharth.db
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Empty means random per process; restart invalidates tokens. Set for persistent deployment.
JWT_SECRET=
POSTGRES_PASSWORD=local-only-change-before-deployment
LLM_ENABLED=false
OPENWORKER_ENABLED=false
# Optional explicit HTTPS OpenAI-compatible chat-completions endpoint:
LLM_URL=
LLM_API_KEY=
LLM_MODEL=
HIGH_THRESHOLD=60
CRITICAL_THRESHOLD=80
RETENTION_DAYS=30
CORS_ORIGINS=
